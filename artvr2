def draw_tree(length, angle, change, level):
    pen.move(DOWN)

    if level > 5:
        pen.set_pen_width(WIDE)
        pen.set_pen_color_rgb(0, 255, 0, 100)
    elif level > 4:
        pen.set_pen_width(MEDIUM)
        pen.set_pen_color_rgb(255, 0, 0, 100)
    elif level > 3:
        pen.set_pen_width(THIN)
        pen.set_pen_color_rgb(0, 0, 255, 100)
    else:
        pen.set_pen_width(EXTRA_THIN)
        pen.set_pen_color_rgb(128, 0, 255, 100)

    if level > 0:
        # 1. Draw the main branch
        drivetrain.drive_for(FORWARD, length, MM)

        # 2. Right subtree
        drivetrain.turn_for(RIGHT, angle, DEGREES)
        draw_tree(change * length, angle, change, level - 1)  # Right branch

        # 3. Left subtree 
        # (Turn left 2 * angle degrees to counteract the previous angle-degree right turn)
        drivetrain.turn_for(LEFT, 2 * angle, DEGREES)
        draw_tree(change * length, angle, change, level - 1)  # Left branch

        # 4. Return to the starting position and orientation
        drivetrain.turn_for(RIGHT, angle, DEGREES)

        # Backtrack down the branch
        pen.move(UP)
        drivetrain.drive_for(REVERSE, length, MM)
        pen.move(DOWN)

    # Final case: stop recursion if the branch is too short


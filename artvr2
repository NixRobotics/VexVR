def point_on_circle(radius, number_of_steps):
    # simple tangent following
    direction = 360 / number_of_steps
    distance = 2 * math.pi * radius / number_of_steps
    return (direction, distance)

def draw_circle(radius, number_of_steps):
    for i in range(number_of_steps):
        turn, distance = point_on_circle(radius, number_of_steps)
        drivetrain.turn_for(RIGHT, turn, DEGREES)
        drivetrain.drive_for(FORWARD, distance, MM)

def draw_spiral(radius, number_of_steps, number_of_loops, change):
    pen.move(DOWN)
    pen.set_pen_width(THIN)
    for i in range(number_of_steps * number_of_loops):
        turn, distance = point_on_circle(radius - change*i, number_of_steps)
        drivetrain.turn_for(RIGHT, turn, DEGREES)
        drivetrain.drive_for(FORWARD, distance, MM)


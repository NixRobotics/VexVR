# Setup
angle = 30  # Split angle
tree_size = 200
tree_depth = 4

def draw_tree(sz, level):
    if level > 0:
        drivetrain.drive_for(FORWARD, sz, MM)
        drivetrain.turn_for(RIGHT, angle, DEGREES)
        draw_tree(0.8 * sz, level - 1)  # Right branch
        drivetrain.turn_for(LEFT, angle, DEGREES)
        draw_tree(0.8 * sz, level - 1)  # Left branch
        drivetrain.turn_for(RIGHT, angle, DEGREES)
        drivetrain.drive_for(REVERSE, sz, MM)

def draw_tree2(branch_length):
    # Base case: stop recursion if the branch is too short
    pen.set_pen_width(EXTRA_THIN)
    if branch_length < 50:
        return
    
    # 1. Draw the main branch
    pen.move(DOWN)
    pen.set_pen_color_rgb(branch_length * 500 % 255, (branch_length + 90) * 500 % 255, (branch_length + 180) * 500 % 255, 100)
    drivetrain.drive_for(FORWARD, branch_length, MM)
    
    # 2. Right subtree
    drivetrain.turn_for(RIGHT, 25, DEGREES)  # Turn right by 25 degrees
    draw_tree2(branch_length - 25)  # Draw a shorter subtree
    
    # 3. Left subtree 
    # (Turn left 50 degrees to counteract the previous 25-degree right turn)
    drivetrain.turn_for(LEFT, 50, DEGREES)  # Turn right by 25 degrees
    draw_tree2(branch_length - 25)  # Draw a shorter subtree
    
    # 4. Return to the starting position and orientation
    drivetrain.turn_for(RIGHT, 25, DEGREES)  # Turn right by 25 degrees
    pen.move(UP)
    drivetrain.drive_for(REVERSE, branch_length, MM)  # Backtrack down the branch


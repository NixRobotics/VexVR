# X/Y elephant, parameter based
def point_on_elephant(radius, number_of_segments, n):
    t = math.radians(n * 360 / number_of_segments)
    y = radius * (- 60 * math.cos(t) + 30 * math.sin(t) - 8 * math.sin(2 * t) + 10 * math.sin(3 * t))
    x = radius * (50 * math.sin(t) + 18 * math.sin(2 * t) - 12 * math.cos(3 * t) + 14 * math.cos(5 * t))
    return (x, y)

# heading and distance to new X/Y from old X/Y
def directions_to_point(x1, y1, x2, y2):
    distance = math.sqrt((x2 - x1) ** 2 + ((y2 - y1) ** 2))
    heading = math.degrees(math.atan2(y2 - y1, x2 - x1))
    brain.print("dist, dir = ", distance, heading)
    brain.new_line()
    return (heading, distance)

